# ---------------------------------------------------------------
# Trading Bot – Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------

# ---------------------------------------------------------------
# Exchange selection
# ---------------------------------------------------------------
# "ccxt"   → crypto via any ccxt-supported exchange (Binance, Bybit, Kraken …)
# "alpaca" → stocks + crypto via Alpaca Markets
EXCHANGE_TYPE=ccxt

# ---------------------------------------------------------------
# ccxt settings (used when EXCHANGE_TYPE=ccxt)
# ---------------------------------------------------------------
# Exchange ID – any valid ccxt exchange id (binance, bybit, kraken, coinbasepro …)
CCXT_EXCHANGE_ID=binance

# Get these from your exchange's API management page
CCXT_API_KEY=your_ccxt_api_key_here
CCXT_API_SECRET=your_ccxt_api_secret_here

# true → use the exchange's testnet/sandbox (strongly recommended to start)
CCXT_SANDBOX=true

# ---------------------------------------------------------------
# Alpaca settings (used when EXCHANGE_TYPE=alpaca)
# ---------------------------------------------------------------
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# "paper" → paper trading (free, no real money)
# "live"  → real money trading (use with extreme caution)
ALPACA_MODE=paper

# ---------------------------------------------------------------
# Asset symbols
# ---------------------------------------------------------------
# Comma-separated list. Use slash notation for ccxt (BTC/USDT),
# no slash for Alpaca stocks (AAPL, TSLA).
SYMBOLS=BTC/USDT,ETH/USDT

# ---------------------------------------------------------------
# Strategy parameters
# ---------------------------------------------------------------
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
TIMEFRAME=1h
OHLCV_LIMIT=200

# ---------------------------------------------------------------
# Risk management
# ---------------------------------------------------------------
# Fraction of equity to risk per trade (0.02 = 2%)
RISK_PER_TRADE=0.02
# Stop-loss distance from entry as a fraction (0.02 = 2%)
STOP_LOSS_PCT=0.02
# Take-profit distance from entry as a fraction (0.04 = 4%)
TAKE_PROFIT_PCT=0.04
# Maximum number of concurrent open positions
MAX_OPEN_POSITIONS=5

# ---------------------------------------------------------------
# Execution
# ---------------------------------------------------------------
# Polling interval in seconds (60 = 1 min, 3600 = 1 hr)
POLL_INTERVAL_SECONDS=60
# Order type: "market" or "limit"
ORDER_TYPE=market

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_FILE=bot.log
LOG_LEVEL=INFO
